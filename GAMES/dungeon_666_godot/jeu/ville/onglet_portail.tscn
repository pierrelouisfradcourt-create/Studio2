[ext_resource type="Script" path="res://jeu/ville/grille.gd" id="2"]

[node name="Portail" type="VBoxContainer"]
size_flags_horizontal = 3
theme_override_constants/separation = 8
script = ExtResource("1")

[node name="Note" type="Label" parent="."]
layout_mode = 2
theme_type_variation = &"Note"
text = "Repartez du dernier checkpoint, ou de n'importe quel point de téléportation déjà ouvert. Les bénédictions repartent de zéro à chaque descente."
