[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://jeu/theme/carte.gd" id="1"]

[node name="Carte" type="PanelContainer"]
size_flags_horizontal = 3
mouse_filter = 1
theme_type_variation = &"Carte"
script = ExtResource("1")

[node name="Fond" type="Button" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"BoutonCarte"

[node name="Colonne" type="VBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 0

[node name="Bandeau" type="Panel" parent="Colonne"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 3)
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"Bandeau"

[node name="Marge" type="MarginContainer" parent="Colonne"]
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 9
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 11

[node name="Contenu" type="VBoxContainer" parent="Colonne/Marge"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 4

[node name="Tete" type="HBoxContainer" parent="Colonne/Marge/Contenu"]
