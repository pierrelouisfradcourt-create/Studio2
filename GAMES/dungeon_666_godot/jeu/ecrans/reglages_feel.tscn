text = "Réglages du feel"

[node name="Note" type="Label" parent="."]
layout_mode = 2
theme_type_variation = &"Petit"
text = "Outil de mise au point : chaque réglette change la partie en cours, tout de suite. Les réglages modifiés sont en or."
