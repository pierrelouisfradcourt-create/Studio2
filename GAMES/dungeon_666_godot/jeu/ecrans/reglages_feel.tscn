[node name="Copier" type="Button" parent="Actions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
theme_type_variation = &"BoutonPetit"
text = "Copier les réglages"

[node name="Reinitialiser" type="Button" parent="Actions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
theme_type_variation = &"BoutonPetit"
text = "Réinitialiser"

[node name="Liste" type="GridContainer" parent="."]
