[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://jeu/ecrans/reglages_feel.gd" id="1"]
[ext_resource type="Script" path="res://jeu/ecrans/grille.gd" id="2"]

[node name="ReglagesFeel" type="VBoxContainer"]
size_flags_horizontal = 3
theme_override_constants/separation = 12
