{
  "type": "objet",
  "requis": ["EVENTS"],
  "fermé": true,
  "champs": {
    "_note": { "type": "texte" },
    "EVENTS": {
      "type": "liste",
      "min": 1,
      "unique": "id",
      "elements": {
        "type": "objet",
        "requis": ["id", "title", "text", "options"],
        "fermé": true,
        "champs": {
          "id": { "type": "texte", "min": 1 },
          "title": { "type": "texte", "min": 1 },
          "text": { "type": "texte", "min": 1 },
          "options": {
            "type": "liste",
            "min": 2,
            "elements": {
              "type": "objet",
              "requis": ["label", "effect"],
              "fermé": true,
              "champs": {
                "label": { "type": "texte", "min": 1 },
                "effect": {
                  "type": "texte",
                  "valeurs": [
                    "none",
                    "bloodBoon",
                    "heal",
                    "gadgetCharge",
                    "cursedChest",
                    "mammonBoon",
                    "gold",
                    "soulBoon",
                    "bloodSouls",
                    "reforge",
                    "pact",
                    "superToHp",
                    "hpToSuper"
                  ]
                },
                "cost": { "type": "nombre", "min": 0 },
                "souls": { "type": "nombre", "min": 0 },
                "hp": { "type": "nombre", "min": 0 },
                "gain": { "type": "nombre", "min": 0 },
                "levels": { "type": "entier", "min": 1 },
                "pct": { "type": "nombre", "min": 0, "max": 100 },
                "need": { "type": "nombre", "min": 0, "max": 100 },
                "pact": { "type": "texte", "ref": "pactes" },
                "rarity": { "type": "texte", "min": 1 },
                "family": { "type": "texte", "min": 1 }
              },
              "_note": "Les champs qu'un effet lit, et leur présence dans le libellé ({champ}), sont gardés par tests/regles/donnees.gd."
            }
          }
        }
      }
    }
  }
}
