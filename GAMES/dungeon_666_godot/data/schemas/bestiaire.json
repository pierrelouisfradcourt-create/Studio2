{
  "type": "objet",
  "requis": ["enemies", "elite", "ROSTER", "EXTRA_ELITE_KINDS", "MELEE_KINDS", "SHOOTER_KINDS"],
  "fermé": true,
  "champs": {
    "_note": { "type": "texte" },
    "enemies": {
      "type": "objet",
      "min": 1,
      "chaque": {
        "type": "objet",
        "requis": ["name", "radius", "hp", "speed", "mass", "damage", "gold"],
        "champs": {
          "name": { "type": "texte", "min": 1 },
          "radius": { "type": "nombre", "min": 1 },
          "hp": { "type": "nombre", "min": 1 },
          "speed": { "type": "nombre", "min": 0 },
          "mass": { "type": "nombre", "min": 0.1 },
          "damage": { "type": "nombre", "min": 0 },
          "gold": { "type": "point" },
          "windup": { "type": "nombre", "min": 0.4 },
          "castTime": { "type": "nombre", "min": 0.4 },
          "channel": { "type": "nombre", "min": 0.4 },
          "slashWindup": { "type": "nombre", "min": 0.4 },
          "pyre": {
            "type": "objet",
            "requis": [
              "count",
              "radius",
              "spread",
              "delay",
              "stagger",
              "linger",
              "tickEvery",
              "tickDamage",
              "wallInset"
            ],
            "fermé": true,
            "champs": {
              "count": { "type": "entier", "min": 1 },
              "radius": { "type": "nombre", "min": 1 },
              "spread": { "type": "nombre", "min": 0 },
              "delay": { "type": "nombre", "min": 0.4 },
              "stagger": { "type": "nombre", "min": 0 },
              "linger": { "type": "nombre", "min": 0 },
              "tickEvery": { "type": "nombre", "min": 0.02 },
              "tickDamage": { "type": "nombre", "min": 0 },
              "wallInset": { "type": "nombre", "min": 0 }
            }
          },
          "recover": { "type": "nombre", "min": 0 },
          "cooldown": { "type": "nombre", "min": 0 },
          "cooldownJitter": { "type": "point" },
          "lockAt": { "type": "nombre", "min": 0, "max": 1 },
          "strikeTime": { "type": "nombre", "min": 0.02 },
          "chargeMaxTime": { "type": "nombre", "min": 0.02 },
          "wallStun": { "type": "nombre", "min": 0 },
          "strafeFlip": { "type": "nombre", "min": 0, "max": 1 },
          "fade": { "type": "nombre", "min": 0 },
          "hiddenTime": { "type": "nombre", "min": 0 },
          "wardMult": { "type": "nombre", "min": 0, "max": 1 },
