; Dungeon 666 — version Godot. Les règles sont portées de GAMES/dungeon_666/src/sim (la
; spécification) et vérifiées au bit près par `bash outils/verifier.sh`.
config_version=5

[application]

config/name="Dungeon 666"
config/version="0.2.0"
run/main_scene="res://jeu/principal.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(0.027, 0.016, 0.039, 1)

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.027, 0.016, 0.039, 1)
textures/vram_compression/import_etc2_astc=true
